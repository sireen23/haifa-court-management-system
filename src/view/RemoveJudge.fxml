<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="463.0" prefWidth="635.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="control.RemoveJudgeController">

    <children>
        <TableView fx:id="judgeTable" layoutX="20.0" layoutY="78.0" prefHeight="306.0" prefWidth="560.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colFirstName" prefWidth="100.0" text="First Name" />
                <TableColumn fx:id="colLastName" prefWidth="100.0" text="Last Name" />
                <TableColumn fx:id="colSpecialization" prefWidth="120.0" text="Specialization" />
                <TableColumn fx:id="colSalary" prefWidth="80.0" text="Salary" />
                <TableColumn fx:id="colPhone" prefWidth="100.0" text="Phone" />
                <TableColumn fx:id="colEmail" prefWidth="150.0" text="Email" />
            </columns>
        </TableView>

        <Button fx:id="deleteButton" layoutX="198.0" layoutY="410.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="93.0" text="DELETE" />
        <Button fx:id="cancelButton" layoutX="307.0" layoutY="410.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="94.0" text="CANCEL" />
      <Label layoutX="77.0" layoutY="24.0" text="REMOVE JUDGE">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <ImageView fx:id="backImage" fitHeight="47.0" fitWidth="44.0" layoutX="20.0" layoutY="15.0" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
         <image>
            <Image url="@../resources/previous.png" />
         </image>
      </ImageView>
    </children>
</AnchorPane>
